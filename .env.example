# ===== LLM 配置（OpenAI 兼容） =====
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# 抽取专用 LLM（默认复用上面）
# EXTRACT_API_KEY=
# EXTRACT_BASE_URL=
# EXTRACT_MODEL_NAME=

# Embedding（默认复用上面）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=minifish
NEO4J_DATABASE=neo4j

# ===== Qdrant =====
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=minifish_chunks

# ===== 并发 =====
EXTRACTION_CONCURRENCY=8
PERSONA_CONCURRENCY=5

# ===== Flask =====
FLASK_DEBUG=True
FLASK_PORT=5101
